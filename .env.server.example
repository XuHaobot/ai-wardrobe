# ============================================================
# AI 智能衣橱 · 服务器侧环境变量模板（CloudBase 控制台 / .env）
# 复制为 .env 并填入真实值；此模板可安全提交（无真实密钥）
# ============================================================

# 通义千问 DashScope（多模态识别 / Embedding / 对话 / 试穿）—— 必填
DASHSCOPE_API_KEY=sk-your-key-here

# 高德天气（天气感知推荐）—— 可选，缺省时推荐忽略天气
AMAP_API_KEY=your-amap-key-here

# JWT 认证（登录态）—— 公网务必改成随机长串
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_SECONDS=14400

# 数据库：本地 SQLite 即可；远程 MySQL 替换下方 URL（需 pymysql 已含）
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/aitryon
DATABASE_URL=sqlite:///./data/outfit.db

# 游客试玩模式（公网展示推荐开启）：进去即有预置衣橱，写操作服务端拦截
ALLOW_GUEST_MODE=true
DEMO_USER_ID=1

# ChromaDB 持久化路径
CHROMA_PERSIST_DIR=./data/chroma

# 腾讯云 COS / 阿里云 OSS（衣物图云端存储）—— 可选；不配则存本地 uploads
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
